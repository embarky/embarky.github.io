---
import Base from '../layouts/Base.astro';
---

<Base title="About — Hang Yang">
  <h2 class="text-xl font-semibold tracking-tight">About</h2>

  <div class="mt-6 space-y-4 text-neutral-700">
    <p>
      Write two or three paragraphs here. What you work on, what problems you
      find interesting, what you are looking for.
    </p>
  </div>

  <h3 class="mt-12 text-sm font-medium tracking-wide text-neutral-400 uppercase">
    Education
  </h3>
  <ul class="mt-4 space-y-3 text-sm">
    <li>
      <span class="font-medium">MSc, Information Systems</span>
      <span class="text-neutral-500"> — University, 2025–2027</span>
    </li>
    <li>
      <span class="font-medium">BSc, Data Science and Big Data Technology</span>
      <span class="text-neutral-500"> — University, 2021–2025</span>
    </li>
  </ul>

  <h3 class="mt-10 text-sm font-medium tracking-wide text-neutral-400 uppercase">
    Skills
  </h3>
  <dl class="mt-4 space-y-2 text-sm">
    <div class="sm:flex sm:gap-4">
      <dt class="w-28 shrink-0 text-neutral-500">Languages</dt>
      <dd>Python, SQL, R, TypeScript</dd>
    </div>
    <div class="sm:flex sm:gap-4">
      <dt class="w-28 shrink-0 text-neutral-500">ML</dt>
      <dd>scikit-learn, XGBoost, PyTorch</dd>
    </div>
    <div class="sm:flex sm:gap-4">
      <dt class="w-28 shrink-0 text-neutral-500">Data</dt>
      <dd>pandas, Spark, dbt, Airflow</dd>
    </div>
    <div class="sm:flex sm:gap-4">
      <dt class="w-28 shrink-0 text-neutral-500">Tools</dt>
      <dd>Git, Docker, Tableau, Streamlit</dd>
    </div>
  </dl>
</Base>